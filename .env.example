# Перед запуском сервера задайте собственный пароль администратора.
BLOOM_ADMIN_PASSWORD=change-this-password

# Разрешённые адреса интерфейса, которым можно обращаться к API.
BLOOM_CORS_ORIGINS=http://localhost:5173,https://roma770.github.io

# SQLite-файл создаётся автоматически при первом запуске.
BLOOM_DATABASE_PATH=data/bloom-joy.sqlite
PORT=3001

# После отдельной публикации сервера укажите его адрес без завершающего /api.
# Для GitHub Actions задайте эту переменную в Settings → Secrets and variables → Actions → Variables.
VITE_API_URL=
